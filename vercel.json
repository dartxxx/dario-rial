{
  "version": 2,
  "builds": [
    {
      "src": "syscore-static/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "api/chat.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/(.*)", "dest": "/syscore-static/$1" }
  ],
